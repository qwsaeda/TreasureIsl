<?xml version="1.0" encoding="utf-8"?>
<!-- 金银岛 TreasureIsl — Android APK 清单（cargo-apk 标准布局，S2.6 / S18.8d 切 Bevy）
     S18.8d：android 壳 = winit `android-native-activity` 后端
     （`android-activity` crate 导出 `JNI_OnLoad` + NativeActivity 生命周期 → `android_main`），
     入口 Activity = `android.app.NativeActivity`（Android 内建，0 自定义 Java/Kotlin 类，
     `libname=android_activity` = cdylib `libandroid_activity.so` 去前缀/后缀）。
     包名 com.example.treasureisland 占位（release 可换自有包名；keystore 用 debug 签名）。
     minSdk 21（Android 5.0），targetSdk 34。不锁方向（P4-2 letterbox 自适应）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.treasureisland"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- 无网络权限（游戏全离线可玩；bevy 资产管线本地 APK assets 直读） -->

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!-- 全屏 + 保持唤醒（游戏场景，防锁屏） -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- S18.8d 入口：NativeActivity（winit android-native-activity 壳约定）；
             2026-11-01（真机/MuMu 实测闪退）：`extractNativeLibs` 改 **true**——
             `false`（.so 直接 mmap 执行）要求 .so 未压缩 + 16KB 对齐（zipalign 仅 -p 4），
             且 arm 转译（MuMu/redroid x86_64 跑 arm64）需解压加载 ⇒ false 报
             INSTALL_FAILED_NO_MATCHING_ABIS / 真机闪退；true = 解压兼容（转译 + 未对齐）。 -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:extractNativeLibs="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:hardwareAccelerated="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="android_activity" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
