   "script": "scripts/gate.ps1",
   "args": [
    "-File",
    "scripts/gate.ps1"
   ],
   "enum_param": {
    "name": "tier",
    "values": [
     "fast",
     "touch",
     "full"
    ],
    "arg_map": {
     "fast": [
      "-Fast"
     ],
     "touch": [
      "-Touch"
     ],
     "full": []
    }
   },
   "writes": [
    "evidence/web_playtest.log",
    "evidence/web_playtest.png",
    "evidence/font_render.txt"
   ],
   "enabled_by_default": true,
   "runner_fallback": [
    "powershell"
   ],
   "_runner_note": "主 runner=pwsh；回退 powershell（22 号 §4.3 候选顺序）；runner::gate::spawn_gate 实现"
  },
  {
