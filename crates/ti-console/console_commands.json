    "values": [
     "code",
     "process",
     "build",
     "tools",
     "formats",
     "reverse"
    ],
    "arg_map": {
     "code": [
      "--volume",
      "code"
     ],
     "process": [
      "--volume",
      "process"
     ],
     "build": [
      "--volume",
      "build"
     ],
     "tools": [
      "--volume",
      "tools"
     ],
     "formats": [
      "--volume",
      "formats"
     ],
     "reverse": [
      "--volume",
      "reverse"
     ]
    }
   },
   "writes": [],
   "enabled_by_default": true,
